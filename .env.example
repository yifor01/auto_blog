OPENROUTER_API_KEY=sk-or-v1-xxxxx
# 可選：多 key round-robin（OPENROUTER_API_KEY_2 ~ _9）
# OPENROUTER_API_KEY_2=sk-or-v1-xxxxx
OPENROUTER_API_URL=https://openrouter.ai/api/v1
# Agnes AI（選用）：OpenRouter 免費 model 全掛時的生成 fallback。
# 端點為 apihub.agnes-ai.com（非官方文件寫的 api.），可加 _2~_9 多 key、AGNES_API_URL 覆寫。
AGNES_API_KEY=
# AGNES_API_URL=https://apihub.agnes-ai.com/v1
NEWSAPI_KEY=
# Semantic Scholar Graph API（選用；無 key 仍可呼叫，只是限流較嚴）
SEMANTIC_SCHOLAR_API_KEY=
