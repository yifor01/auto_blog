---
interface Props {
  active: 'curated' | 'daily' | 'trending' | 'papers';
}
const { active } = Astro.props;
---

<nav class="tabs">
  <a href="/" class:list={['tab', { active: active === 'daily' }]}>
    ⚡ 每日自動
  </a>
  <a href="/curated" class:list={['tab', { active: active === 'curated' }]}>
    ★ 精選
  </a>
  <a href="/trending" class:list={['tab', { active: active === 'trending' }]}>
    🔥 Trending
  </a>
  <a href="/papers" class:list={['tab', { active: active === 'papers' }]}>
    📄 Papers
  </a>
</nav>

<style>
  .tabs {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0;
  }
  .tab {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--muted);
    padding: 0.45rem 0.9rem;
    border: 1px solid transparent;
    border-bottom: none;
    border-radius: 8px 8px 0 0;
    position: relative;
    top: 1px;
    transition:
      color 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }
  .tab:hover {
    color: var(--text);
    background: var(--surface);
  }
  .tab.active {
    color: var(--accent);
    background: var(--surface);
    border-color: var(--border);
    border-bottom: 1px solid var(--bg);
  }
</style>
