---
interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}
const { title, description, wide = false } = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body>
    <div class="topbar"></div>
    <main class={wide ? 'wide' : ''}>
      <slot />
    </main>
    <style is:global>
      :root {
        --bg: #0a0c10;
        --bg-elev: #0f1318;
        --surface: #141a21;
        --surface-hover: #18202a;
        --border: #232c38;
        --border-strong: #2f3b4a;
        --text: #e8eef5;
        --muted: #8b98a9;
        --faint: #5f6b7a;
        --accent: #5db1ff;
        --accent-2: #9d7bff;
        --accent-cyan: #4fe0d0;
        --glow: rgba(93, 177, 255, 0.18);
        --radius: 12px;
        --mono: "SFMono-Regular", "JetBrains Mono", "Consolas",
          "Liberation Mono", ui-monospace, monospace;
        --sans: -apple-system, "Segoe UI", "Noto Sans TC", "PingFang TC",
          "Microsoft JhengHei", system-ui, sans-serif;
      }
      * {
        box-sizing: border-box;
      }
      html {
        background: var(--bg);
        color: var(--text);
        font-family: var(--sans);
        line-height: 1.75;
        -webkit-text-size-adjust: 100%;
        scroll-behavior: smooth;
        /* 永遠保留捲軸槽，避免有/無捲軸頁面切換時內容橫向位移 */
        scrollbar-gutter: stable;
      }
      body {
        margin: 0;
        min-height: 100vh;
        /* 微妙的雙色徑向光暈 + 點陣格線，營造終端機質感 */
        background-color: var(--bg);
        background-image:
          radial-gradient(
            900px circle at 15% -5%,
            rgba(93, 177, 255, 0.08),
            transparent 55%
          ),
          radial-gradient(
            800px circle at 95% 0%,
            rgba(157, 123, 255, 0.07),
            transparent 50%
          ),
          radial-gradient(
            rgba(255, 255, 255, 0.018) 1px,
            transparent 1px
          );
        background-size: 100% 100%, 100% 100%, 22px 22px;
        background-attachment: fixed;
      }
      /* 頂部漸層細條 */
      .topbar {
        position: fixed;
        inset: 0 0 auto 0;
        height: 2px;
        background: linear-gradient(
          90deg,
          var(--accent),
          var(--accent-2),
          var(--accent-cyan)
        );
        z-index: 50;
      }
      main {
        max-width: 760px;
        margin: 0 auto;
        padding: 3rem 1.25rem 6rem;
      }
      main.wide {
        max-width: 1320px;
      }
      a {
        color: var(--accent);
        text-decoration: none;
        transition: color 0.15s ease;
      }
      a:hover {
        color: var(--accent-cyan);
      }
      h1,
      h2,
      h3 {
        line-height: 1.3;
        font-weight: 700;
        letter-spacing: -0.01em;
      }
      img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
      }
      pre {
        background: #0b0f14;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1rem 1.1rem;
        overflow-x: auto;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.02);
      }
      code {
        font-family: var(--mono);
        font-size: 0.88em;
      }
      :not(pre) > code {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.12em 0.42em;
        color: var(--accent-cyan);
      }
      blockquote {
        border-left: 3px solid var(--accent);
        margin-inline: 0;
        padding: 0.2rem 0 0.2rem 1rem;
        color: var(--muted);
        background: linear-gradient(
          90deg,
          var(--glow),
          transparent 70%
        );
        border-radius: 0 8px 8px 0;
      }
      hr {
        border: none;
        border-top: 1px solid var(--border);
        margin: 2rem 0;
      }
      table {
        border-collapse: collapse;
        width: 100%;
        font-size: 0.92rem;
      }
      th,
      td {
        border: 1px solid var(--border);
        padding: 0.55rem 0.8rem;
        text-align: left;
      }
      th {
        background: var(--surface);
      }
      ::selection {
        background: rgba(93, 177, 255, 0.3);
      }
    </style>
  </body>
</html>
