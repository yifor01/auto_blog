---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { idDate, formatDate, recentCutoff, RECENT_DAYS, excerpt, readingMinutes } from '../utils';
import { loadEnrichment, normalizeUrl, DIM_LABELS } from '../enrich';

const all = await getCollection('posts');
const cutoff = recentCutoff();
const enrich = loadEnrichment();

const recent = all
  .filter((p) => idDate(p.id) >= cutoff)
  .sort(
    (a, b) =>
      idDate(b.id).getTime() - idDate(a.id).getTime() ||
      Number(b.data.pinned) - Number(a.data.pinned)
  );

const items = recent.map((p) => {
  const source = p.data.source ?? '其他';
  const summary = excerpt(p.body);
  const date = idDate(p.id);
  const e = enrich.get(normalizeUrl(p.data.url));
  const tags = e?.tags ?? [];
  const org = e?.organization ?? '';
  const dims = e
    ? DIM_LABELS.map(([key, label]) => ({ label, value: Number(e[key]) || 0 }))
    : null;
  return {
    id: p.id,
    title: p.data.title,
    source,
    score: p.data.score,
    pinned: p.data.pinned,
    url: p.data.url,
    summary,
    date,
    day: date.toISOString().slice(0, 10),
    month: date.toISOString().slice(0, 7),
    tags,
    org,
    dims,
    readMins: readingMinutes(p.body),
    search: [p.data.title, source, summary, org, ...tags, e?.abstract ?? '']
      .join(' ')
      .toLowerCase(),
  };
});

// 日期分組（保持時間序）
const dayGroups: { day: string; date: Date; items: typeof items }[] = [];
for (const item of items) {
  const last = dayGroups[dayGroups.length - 1];
  if (last && last.day === item.day) last.items.push(item);
  else dayGroups.push({ day: item.day, date: item.date, items: [item] });
}
const weekdayFmt = new Intl.DateTimeFormat('zh-TW', { weekday: 'short', timeZone: 'UTC' });

// facets
const sourceCounts = new Map<string, number>();
const monthCounts = new Map<string, number>();
// tag 以小寫為比對鍵（不同文章大小寫不一），顯示用第一次出現的原樣
const tagCounts = new Map<string, { label: string; count: number }>();
for (const it of items) {
  sourceCounts.set(it.source, (sourceCounts.get(it.source) ?? 0) + 1);
  monthCounts.set(it.month, (monthCounts.get(it.month) ?? 0) + 1);
  for (const t of it.tags) {
    const key = t.toLowerCase();
    const e = tagCounts.get(key);
    if (e) e.count++;
    else tagCounts.set(key, { label: t, count: 1 });
  }
}
const sources = [...sourceCounts.entries()].sort((a, b) => b[1] - a[1]);
const months = [...monthCounts.entries()].sort((a, b) => b[0].localeCompare(a[0]));
const topTags = [...tagCounts.entries()]
  .filter(([, e]) => e.count >= 2)
  .sort((a, b) => b[1].count - a[1].count)
  .slice(0, 18);

// 最新一天統計
const latest = dayGroups[0];
const latestAvg = latest
  ? Math.round(latest.items.reduce((s, i) => s + (i.score ?? 0), 0) / latest.items.length)
  : 0;
---

<Base title="每日自動 — Daily AI Blog" wide>
  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-inner">
        <header class="brand-block">
          <a href="/" class="brand">Daily AI Blog</a>
          <p class="subtitle">
            <span class="prompt">⚡</span> 每日自動 · 近 {RECENT_DAYS} 天
          </p>
          {
            latest && (
              <p class="stats-line">
                最新 {latest.day.slice(5)} · {latest.items.length} 篇 · 均分 {latestAvg}
              </p>
            )
          }
        </header>

        <div class="search-box">
          <input
            type="search"
            id="search"
            placeholder="搜尋標題 / 來源 / 標籤…  (/)"
            autocomplete="off"
          />
        </div>

        <div class="control-row">
          <span class="ctrl-label">排序</span>
          <button class="sort-btn active" data-sort="date">最新</button>
          <button class="sort-btn" data-sort="score">分數</button>
        </div>

        <div class="control-row">
          <button class="toggle-btn" data-toggle="unread">未讀</button>
          <button class="toggle-btn" data-toggle="bm">★ 收藏</button>
          <button id="density" class="toggle-btn" title="切換精簡列表">精簡</button>
        </div>

        <button id="reset" class="reset" hidden>✕ 清除篩選</button>

        <section class="facet">
          <h3 class="facet-title">月份</h3>
          <ul class="facet-list">
            {
              months.map(([m, c]) => (
                <li>
                  <button class="facet-btn" data-type="month" data-value={m}>
                    <span>{m}</span>
                    <span class="count">{c}</span>
                  </button>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="facet">
          <h3 class="facet-title">來源 <span class="count">{sources.length}</span></h3>
          <ul class="facet-list">
            {
              sources.map(([s, c]) => (
                <li>
                  <button class="facet-btn" data-type="source" data-value={s}>
                    <span class="src-name">{s}</span>
                    <span class="count">{c}</span>
                  </button>
                </li>
              ))
            }
          </ul>
        </section>

        {
          topTags.length > 0 && (
            <section class="facet">
              <h3 class="facet-title">標籤</h3>
              <div class="tag-cloud">
                {topTags.map(([key, e]) => (
                  <button class="facet-btn tag-btn" data-type="tag" data-value={key}>
                    {e.label} <span class="count">{e.count}</span>
                  </button>
                ))}
              </div>
            </section>
          )
        }

        <p class="kbd-hint">
          <kbd>/</kbd> 搜尋 · <kbd>j</kbd><kbd>k</kbd> 移動 · <kbd>↵</kbd> 開啟 ·
          <kbd>b</kbd> 收藏
        </p>
      </div>
    </aside>

    <div class="content">
      <Nav active="daily" />
      <div class="result-bar">
        <span id="result-count">{items.length}</span> 篇 ·
        <span class="dim">近 {RECENT_DAYS} 天（全部 {all.length} 篇）</span>
      </div>

      <ul class="post-list">
        {
          dayGroups.map((g) => (
            <>
              <li class="day-header" data-day={g.day}>
                <span class="day-rel" />
                <span class="day-date">
                  {g.day} · {weekdayFmt.format(g.date)}
                </span>
                <span class="day-count">{g.items.length} 篇</span>
                <span class="day-line" />
              </li>
              {g.items.map((post) => (
                <li
                  class="post-item"
                  data-id={post.id}
                  data-day={post.day}
                  data-month={post.month}
                  data-source={post.source}
                  data-tags={post.tags.map((t) => t.toLowerCase()).join('|')}
                  data-score={post.score ?? 0}
                  data-search={post.search}
                >
                  <a href={`/daily/${post.id}`} class="post-link">
                    <div class="post-meta">
                      <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
                      {post.pinned && <span class="pin-badge">📌 置頂</span>}
                      <span class="source-badge">{post.source}</span>
                      {post.org && <span class="org-badge">{post.org}</span>}
                      {post.score != null && <span class="score">★ {Math.round(post.score)}</span>}
                      <span class="read-mins">{post.readMins} min</span>
                      {post.dims && (
                        <span
                          class="dims"
                          title={post.dims.map((d) => `${d.label} ${d.value}/20`).join(' · ')}
                        >
                          {post.dims.map((d) => (
                            <span class="dim-bar">
                              <span class="dim-fill" style={`height:${(d.value / 20) * 100}%`} />
                            </span>
                          ))}
                        </span>
                      )}
                      <span class="read-check" aria-label="已讀">✓ 已讀</span>
                    </div>
                    <h2 class="post-title">{post.title}</h2>
                    {post.summary && <p class="post-tldr">{post.summary}</p>}
                    {post.tags.length > 0 && (
                      <p class="post-tags">
                        {post.tags.slice(0, 4).map((t) => (
                          <span class="tag-chip">{t}</span>
                        ))}
                      </p>
                    )}
                    <span class="arrow" aria-hidden="true">→</span>
                  </a>
                  <button class="bm-btn" title="收藏 (b)" aria-label="收藏">★</button>
                </li>
              ))}
            </>
          ))
        }
      </ul>

      <p class="empty" hidden>沒有符合條件的文章。</p>
    </div>
  </div>
</Base>

<script>
  import { initFilter } from '../scripts/filter';
  initFilter();
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3rem;
    align-items: start;
  }
  .sidebar {
    position: sticky;
    top: 1.5rem;
  }
  .sidebar-inner {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    max-height: calc(100vh - 3rem);
    overflow-y: auto;
    padding-right: 0.4rem;
  }
  .brand {
    display: block;
    font-size: 1.55rem;
    font-weight: 700;
    background: linear-gradient(
      100deg,
      var(--accent) 10%,
      var(--accent-2) 55%,
      var(--accent-cyan) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    width: fit-content;
  }
  .brand:hover {
    color: transparent;
  }
  .subtitle {
    margin: 0.3rem 0 0;
    color: var(--muted);
    font-size: 0.82rem;
  }
  .stats-line {
    margin: 0.25rem 0 0;
    color: var(--faint);
    font-family: var(--mono);
    font-size: 0.74rem;
  }
  .prompt {
    color: var(--accent-cyan);
    font-weight: 700;
  }
  .search-box input {
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 9px;
    padding: 0.55rem 0.75rem;
    color: var(--text);
    font-family: var(--sans);
    font-size: 0.88rem;
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .search-box input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--glow);
  }
  .search-box input::placeholder {
    color: var(--faint);
  }
  .control-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .ctrl-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-right: 0.15rem;
  }
  .sort-btn,
  .toggle-btn {
    background: transparent;
    border: 1px solid var(--border-strong);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.76rem;
    border-radius: 7px;
    padding: 0.25rem 0.6rem;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      color 0.15s ease,
      background 0.15s ease;
  }
  .sort-btn:hover,
  .toggle-btn:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .sort-btn.active,
  .toggle-btn.active {
    background: rgba(93, 177, 255, 0.12);
    border-color: var(--accent);
    color: var(--accent);
  }
  .reset {
    align-self: flex-start;
    background: rgba(157, 123, 255, 0.1);
    border: 1px solid var(--border-strong);
    color: var(--accent-2);
    font-family: var(--mono);
    font-size: 0.76rem;
    border-radius: 7px;
    padding: 0.25rem 0.6rem;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .reset:hover {
    border-color: var(--accent-2);
  }
  .facet-title {
    margin: 0 0 0.6rem;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--faint);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .facet-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .facet-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 0.3rem 0.55rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.78rem;
    text-align: left;
    cursor: pointer;
    transition:
      background 0.13s ease,
      color 0.13s ease,
      border-color 0.13s ease;
  }
  .facet-btn:hover {
    background: var(--surface);
    color: var(--text);
  }
  .facet-btn.active {
    background: rgba(93, 177, 255, 0.12);
    border-color: var(--accent);
    color: var(--accent);
  }
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .tag-btn {
    width: auto;
    border-color: var(--border);
    padding: 0.18rem 0.5rem;
    font-size: 0.74rem;
  }
  .src-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .count {
    flex-shrink: 0;
    font-size: 0.72rem;
    color: var(--faint);
    background: var(--surface);
    border-radius: 5px;
    padding: 0 0.35rem;
  }
  .facet-btn.active .count {
    color: var(--accent);
  }
  .kbd-hint {
    margin: 0;
    color: var(--faint);
    font-size: 0.72rem;
    font-family: var(--mono);
    line-height: 1.9;
  }
  .kbd-hint kbd {
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    padding: 0 0.3rem;
    font-family: var(--mono);
    font-size: 0.7rem;
  }

  .result-bar {
    color: var(--muted);
    font-size: 0.82rem;
    font-family: var(--mono);
    margin-bottom: 1rem;
  }
  .result-bar #result-count {
    color: var(--accent);
  }
  .result-bar .dim {
    color: var(--faint);
  }
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .day-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--faint);
    margin-top: 0.9rem;
  }
  .day-header:first-child {
    margin-top: 0;
  }
  .day-header[hidden] {
    display: none;
  }
  .day-rel {
    color: var(--accent-cyan);
    font-weight: 700;
  }
  .day-rel:empty {
    display: none;
  }
  .day-date {
    color: var(--muted);
  }
  .day-count {
    background: var(--surface);
    border-radius: 5px;
    padding: 0 0.4rem;
  }
  .day-line {
    flex: 1;
    height: 1px;
    background: var(--border);
  }
  .post-item[hidden] {
    display: none;
  }
  .post-item {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    position: relative;
    overflow: hidden;
    transition:
      border-color 0.18s ease,
      box-shadow 0.18s ease,
      transform 0.18s ease,
      background 0.18s ease;
  }
  .post-item::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: linear-gradient(var(--accent), var(--accent-2));
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .post-item:hover,
  .post-item.kbd-focus {
    border-color: var(--accent);
    background: var(--surface-hover);
    box-shadow: 0 0 0 1px var(--accent), 0 8px 30px -12px var(--glow);
    transform: translateY(-2px);
  }
  .post-item:hover::before,
  .post-item.kbd-focus::before {
    opacity: 1;
  }
  .post-link {
    display: block;
    padding: 1rem 1.4rem;
    color: inherit;
  }
  .post-link:hover {
    color: inherit;
  }
  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-family: var(--mono);
    color: var(--faint);
    font-size: 0.74rem;
    margin-bottom: 0.4rem;
  }
  .pin-badge {
    color: #ffce4f;
    border: 1px solid var(--border-strong);
    border-radius: 5px;
    padding: 0 0.4rem;
    font-weight: 600;
  }
  .source-badge {
    color: var(--accent-cyan);
    border: 1px solid var(--border-strong);
    border-radius: 5px;
    padding: 0 0.4rem;
  }
  .org-badge {
    color: var(--accent-2);
    border: 1px solid var(--border-strong);
    border-radius: 5px;
    padding: 0 0.4rem;
  }
  .score {
    color: var(--accent-2);
  }
  .read-mins {
    color: var(--faint);
  }
  .dims {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
    cursor: help;
  }
  .dim-bar {
    display: inline-block;
    width: 4px;
    height: 12px;
    background: var(--border);
    border-radius: 1px;
    position: relative;
    overflow: hidden;
  }
  .dim-fill {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(var(--accent-cyan), var(--accent));
    border-radius: 1px;
  }
  .read-check {
    display: none;
    color: var(--faint);
  }
  .post-item.is-read .read-check {
    display: inline;
  }
  .post-item.is-read .post-title {
    color: var(--muted);
  }
  .post-title {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
    color: var(--text);
    transition: color 0.18s ease;
    padding-right: 2.4rem;
  }
  .post-item:hover .post-title,
  .post-item.kbd-focus .post-title {
    color: var(--accent);
  }
  .post-tldr {
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.55;
  }
  .post-tags {
    margin: 0.45rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .tag-chip {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--muted);
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 0 0.4rem;
  }
  /* 精簡模式：只留 meta + 標題 */
  :global(body.compact) .post-tldr,
  :global(body.compact) .post-tags,
  :global(body.compact) .dims {
    display: none;
  }
  :global(body.compact) .post-link {
    padding: 0.6rem 1.4rem;
  }
  :global(body.compact) .post-title {
    font-size: 0.95rem;
    margin-bottom: 0;
  }
  .arrow {
    position: absolute;
    right: 1.2rem;
    bottom: 1rem;
    color: var(--accent);
    font-size: 1.1rem;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }
  .post-item:hover .arrow,
  .post-item.kbd-focus .arrow {
    opacity: 1;
    transform: translateX(0);
  }
  .bm-btn {
    position: absolute;
    right: 0.9rem;
    top: 0.7rem;
    background: transparent;
    border: none;
    color: var(--border-strong);
    font-size: 1.05rem;
    cursor: pointer;
    padding: 0.15rem 0.3rem;
    transition: color 0.15s ease, transform 0.15s ease;
    z-index: 2;
  }
  .bm-btn:hover {
    color: var(--accent-2);
    transform: scale(1.2);
  }
  .post-item.is-bm .bm-btn {
    color: #ffce4f;
  }
  .empty {
    color: var(--muted);
    text-align: center;
    padding: 3rem 0;
  }

  @media (max-width: 760px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .sidebar {
      position: static;
    }
    .sidebar-inner {
      max-height: none;
      overflow: visible;
    }
    .kbd-hint {
      display: none;
    }
  }
</style>
